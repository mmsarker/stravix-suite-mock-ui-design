{"/app/tenant-admin/modules":"<ui-section-card title=\"Tenant-enabled apps\" subtitle=\"Apps available to this tenant.\">\n  <div headerActions class=\"catalogue-summary\">{{ tenantEnabledCount() }} apps · {{ categoryCount() }} categories</div>\n\n  <div class=\"list-controls\">\n    <ui-input class=\"search-input\" placeholder=\"Search apps\" [ngModel]=\"query()\" (ngModelChange)=\"query.set(($event || '').toString())\" />\n\n    <div class=\"view-actions\">\n      <div class=\"view-toggle\" role=\"group\" aria-label=\"App view\">\n        <ui-button type=\"button\" size=\"sm\" [variant]=\"viewMode() === 'list' ? 'primary' : 'secondary'\" (click)=\"setViewMode('list')\">\n          List\n        </ui-button>\n        <ui-button type=\"button\" size=\"sm\" [variant]=\"viewMode() === 'cards' ? 'primary' : 'secondary'\" (click)=\"setViewMode('cards')\">\n          Cards\n        </ui-button>\n      </div>\n    </div>\n  </div>\n\n  @if (loading()) {\n  <ui-loading-state>\n    <div class=\"loading-dots\"><span></span><span></span><span></span></div>\n    <span>Loading apps...</span>\n  </ui-loading-state>\n  } @else if (filteredModules().length === 0) {\n  <ui-empty-state>\n    <strong>No apps found</strong>\n    <span>Only apps enabled for this tenant are shown here.</span>\n  </ui-empty-state>\n  } @else if (viewMode() === 'cards') {\n  <div class=\"module-grid\">\n    @for (module of filteredModules(); track module.code) {\n    <article class=\"module-card card-enabled\" [class.card-inactive]=\"!module.isActive\">\n      <div class=\"card-top\">\n        <div class=\"module-icon icon-on\">\n          @if (module.logoUrl) {\n          <img [src]=\"module.logoUrl\" alt=\"\" />\n          } @else {\n          <span>{{ module.name.slice(0, 2).toUpperCase() }}</span>\n          }\n        </div>\n        <ui-status-pill class=\"pill-on\">Available</ui-status-pill>\n      </div>\n\n      <div class=\"card-content\">\n        <h3 class=\"card-title\">{{ module.name }}</h3>\n        <code class=\"card-code\">{{ module.code }}</code>\n        <div class=\"card-tags\">\n          <span class=\"category-tag\">{{ module.category || 'Uncategorized' }}</span>\n          <span class=\"order-tag\">Order {{ module.displayOrder || 0 }}</span>\n        </div>\n      </div>\n\n      <div class=\"card-footer\">\n        <span class=\"read-only-note\">Enabled for tenant</span>\n      </div>\n    </article>\n    }\n  </div>\n  } @else {\n  <div class=\"module-table\">\n    <div class=\"module-row table-head\" role=\"row\">\n      <span>App</span>\n      <span>Category</span>\n      <span>Status</span>\n    </div>\n    @for (module of filteredModules(); track module.code) {\n    <div class=\"module-row row-enabled\" [class.row-inactive]=\"!module.isActive\" role=\"row\">\n      <div class=\"module-name-cell\">\n        <div class=\"module-icon small icon-on\">\n          @if (module.logoUrl) {\n          <img [src]=\"module.logoUrl\" alt=\"\" />\n          } @else {\n          <span>{{ module.name.slice(0, 2).toUpperCase() }}</span>\n          }\n        </div>\n        <div>\n          <strong>{{ module.name }}</strong>\n          <code>{{ module.code }}</code>\n        </div>\n      </div>\n      <span class=\"row-category\">{{ module.category || 'Uncategorized' }}</span>\n      <ui-status-pill class=\"pill-on\">Available</ui-status-pill>\n    </div>\n    }\n  </div>\n  }\n</ui-section-card>\n","/app/ecommerce/settings":"<div class=\"form-card\" *ngIf=\"!loading\">\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Store Identity</h3>\n    <div class=\"field-grid\">\n      <div class=\"field\">\n        <label for=\"store-settings-page.component-form-storename\">Store Name *</label>\n        <ui-input\n          id=\"store-settings-page.component-form-storename\"\n          type=\"text\"\n          [(ngModel)]=\"form.storeName\"\n          (ngModelChange)=\"clearFieldError('storeName')\"\n          [class.invalid-field]=\"fieldError('storeName')\"\n          placeholder=\"My Commerce Store\"\n         />\n        <small class=\"field-error\" *ngIf=\"fieldError('storeName')\">{{ fieldError('storeName') }}</small>\n      </div>\n\n      <div class=\"logo-panel\">\n        <div class=\"logo-preview\" [class.empty]=\"!form.logoUrl\">\n          <img *ngIf=\"form.logoUrl; else logoInitialsTpl\" [src]=\"form.logoUrl\" alt=\"Store logo\" />\n          <ng-template #logoInitialsTpl>\n            <span>{{ logoInitials() }}</span>\n          </ng-template>\n        </div>\n        <div class=\"logo-copy\">\n          <strong>{{ form.logoUrl ? 'Store logo uploaded' : 'No logo uploaded' }}</strong>\n          <span>PNG, JPG, or WebP. Resize before upload. Maximum 2 MB.</span>\n          <code *ngIf=\"logoFileRef\">{{ logoFileRef }}</code>\n          <div class=\"logo-actions\">\n            <label class=\"upload-trigger\" for=\"store-logo-upload\">\n              <ui-file-upload\n                id=\"store-logo-upload\"\n                accept=\"image/png,image/jpeg,image/webp\"\n                (selected)=\"uploadLogo($event)\"\n                [disabled]=\"logoUploading || logoRemoving\"\n               />\n              {{ logoUploading ? 'Uploading...' : form.logoUrl ? 'Replace logo' : 'Upload logo' }}\n            </label>\n            <ui-button\n              type=\"button\"\n              class=\"btn-link\"\n              *ngIf=\"form.logoUrl\"\n              (click)=\"removeLogo()\"\n              [disabled]=\"logoUploading || logoRemoving\"\n             variant=\"danger\">\n              {{ logoRemoving ? 'Removing...' : 'Remove logo' }}\n            </ui-button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Currency & Pricing</h3>\n    <div class=\"field-grid\">\n      <div class=\"field\">\n        <label for=\"store-settings-page.component-form-currency\">Currency</label>\n        <ui-select\n          id=\"store-settings-page.component-form-currency\"\n          [(ngModel)]=\"form.currency\"\n          (ngModelChange)=\"clearFieldError('currency')\"\n          [class.invalid-field]=\"fieldError('currency')\"\n        >\n          <option *ngIf=\"unknownCurrency() as code\" [value]=\"code\">Current: {{ code }}</option>\n          <option *ngFor=\"let option of currencyOptions\" [value]=\"option.code\">{{ option.label }}</option>\n        </ui-select>\n        <small class=\"field-error\" *ngIf=\"fieldError('currency')\">{{ fieldError('currency') }}</small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-tax-registration-number\">VAT/BIN Number</label>\n        <ui-input\n          id=\"store-tax-registration-number\"\n          type=\"text\"\n          [(ngModel)]=\"form.taxRegistrationNumber\"\n          placeholder=\"VAT/BIN shown on receipts\"\n         />\n      </div>\n      <div class=\"field\">\n        <label for=\"store-default-tax-country\">Default Tax Country</label>\n        <ui-input\n          id=\"store-default-tax-country\"\n          type=\"text\"\n          maxlength=\"2\"\n          [(ngModel)]=\"form.defaultTaxCountryCode\"\n          (ngModelChange)=\"clearFieldError('defaultTaxCountryCode')\"\n          [class.invalid-field]=\"fieldError('defaultTaxCountryCode')\"\n          placeholder=\"BD\"\n         />\n        <small class=\"field-error\" *ngIf=\"fieldError('defaultTaxCountryCode')\">\n          {{ fieldError('defaultTaxCountryCode') }}\n        </small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-default-tax-region\">Default Tax Region</label>\n        <ui-input\n          id=\"store-default-tax-region\"\n          type=\"text\"\n          [(ngModel)]=\"form.defaultTaxRegionCode\"\n          placeholder=\"Optional region/state\"\n         />\n      </div>\n      <div class=\"field\">\n        <label for=\"store-default-tax-mode\">Default Tax Mode</label>\n        <ui-select\n          id=\"store-default-tax-mode\"\n          [(ngModel)]=\"form.defaultTaxCalculationMode\"\n          (ngModelChange)=\"clearFieldError('defaultTaxCalculationMode')\"\n          [class.invalid-field]=\"fieldError('defaultTaxCalculationMode')\"\n        >\n          <option value=\"exclusive\">Exclusive</option>\n          <option value=\"inclusive\">Inclusive</option>\n        </ui-select>\n        <small class=\"field-error\" *ngIf=\"fieldError('defaultTaxCalculationMode')\">\n          {{ fieldError('defaultTaxCalculationMode') }}\n        </small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-receipt-tax-display\">Receipt Tax Display</label>\n        <ui-select\n          id=\"store-receipt-tax-display\"\n          [(ngModel)]=\"form.receiptTaxDisplayMode\"\n          (ngModelChange)=\"clearFieldError('receiptTaxDisplayMode')\"\n          [class.invalid-field]=\"fieldError('receiptTaxDisplayMode')\"\n        >\n          <option value=\"summary\">Summary</option>\n          <option value=\"line\">Line and summary</option>\n          <option value=\"hidden\">Hidden</option>\n        </ui-select>\n        <small class=\"field-error\" *ngIf=\"fieldError('receiptTaxDisplayMode')\">\n          {{ fieldError('receiptTaxDisplayMode') }}\n        </small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-tax-percent\">Legacy Tax Rate (%)</label>\n        <ui-number-input\n          id=\"store-tax-percent\"\n          type=\"number\"\n          [(ngModel)]=\"form.taxPercent\"\n          (ngModelChange)=\"clearFieldError('taxPercent')\"\n          [class.invalid-field]=\"fieldError('taxPercent')\"\n          min=\"0\"\n          max=\"100\"\n          step=\"0.01\"\n          placeholder=\"0.00\"\n         />\n        <small class=\"field-hint\">Compatibility only. Catalog Tax Rules now calculate effective VAT.</small>\n        <small class=\"field-error\" *ngIf=\"fieldError('taxPercent')\">{{ fieldError('taxPercent') }}</small>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"sticky-save-bar\">\n    <span>{{ hasUnsavedChanges() ? 'Unsaved settings changes' : 'Settings are up to date' }}</span>\n    <ui-button type=\"button\"  (click)=\"save()\" [disabled]=\"saving\" variant=\"primary\">\n      {{ saving ? 'Saving...' : 'Save Settings' }}\n    </ui-button>\n  </div>\n\n  <div class=\"error-msg\" *ngIf=\"errorMsg\">{{ errorMsg }}</div>\n  <div class=\"success-msg\" *ngIf=\"successMsg\">{{ successMsg }}</div>\n</div>\n\n<ui-loading-state  *ngIf=\"loading\">Loading settings...</ui-loading-state>\n\n<ui-image-resize-dialog\n  [open]=\"logoResizeOpen\"\n  [file]=\"logoResizeFile\"\n  title=\"Resize Store Logo\"\n  subtitle=\"Position the logo inside the square preview.\"\n  dialogLabel=\"Resize store logo\"\n  applyLabel=\"Use logo\"\n  outputLabel=\"Output\"\n  shape=\"square\"\n  [outputSize]=\"logoOutputSize\"\n  outputFileName=\"store-logo.jpg\"\n  outputMimeType=\"image/jpeg\"\n  [outputQuality]=\"0.9\"\n  [tips]=\"logoResizeTips\"\n  (closed)=\"closeLogoResize()\"\n  (resized)=\"applyLogoResize($event)\"\n/>\n","/admin/observability":"<ng-container *ngIf=\"obs.stateVersion() >= 0\">\n  <app-scheduler-run-ledger\n    [pageSizeOptions]=\"obs.pageSizeOptions\"\n    [filters]=\"filters\"\n    [schedulerRunPage]=\"page\"\n    [snapshotRuns]=\"obs.snapshot?.schedulerRuns ?? []\"\n    [loading]=\"loading\"\n    [error]=\"error\"\n    [selectedSchedulerRunId]=\"selectedRunId\"\n    [schedulerTenantRuns]=\"tenantRuns\"\n    [schedulerTenantRunsLoading]=\"tenantRunsLoading\"\n    [schedulerTenantRunsError]=\"tenantRunsError\"\n    [serviceOptions]=\"serviceOptions\"\n    [jobOptions]=\"jobOptions\"\n    (exportRequested)=\"export()\"\n    (loadRequested)=\"load($event)\"\n    (resetRequested)=\"reset()\"\n    (pageSizeChanged)=\"setPageSize($event)\"\n    (selectRunRequested)=\"selectRun($event)\"\n  />\n</ng-container>\n"}
