{"general":"<div class=\"form-card\" *ngIf=\"!loading\">\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Store Identity</h3>\n    <div class=\"field-grid\">\n      <div class=\"field\">\n        <label for=\"store-settings-page.component-form-storename\">Store Name *</label>\n        <ui-input\n          id=\"store-settings-page.component-form-storename\"\n          type=\"text\"\n          [(ngModel)]=\"form.storeName\"\n          (ngModelChange)=\"clearFieldError('storeName')\"\n          [class.invalid-field]=\"fieldError('storeName')\"\n          placeholder=\"My Commerce Store\"\n         />\n        <small class=\"field-error\" *ngIf=\"fieldError('storeName')\">{{ fieldError('storeName') }}</small>\n      </div>\n\n      <div class=\"logo-panel\">\n        <div class=\"logo-preview\" [class.empty]=\"!form.logoUrl\">\n          <img *ngIf=\"form.logoUrl; else logoInitialsTpl\" [src]=\"form.logoUrl\" alt=\"Store logo\" />\n          <ng-template #logoInitialsTpl>\n            <span>{{ logoInitials() }}</span>\n          </ng-template>\n        </div>\n        <div class=\"logo-copy\">\n          <strong>{{ form.logoUrl ? 'Store logo uploaded' : 'No logo uploaded' }}</strong>\n          <span>PNG, JPG, or WebP. Resize before upload. Maximum 2 MB.</span>\n          <code *ngIf=\"logoFileRef\">{{ logoFileRef }}</code>\n          <div class=\"logo-actions\">\n            <label class=\"upload-trigger\" for=\"store-logo-upload\">\n              <ui-file-upload\n                id=\"store-logo-upload\"\n                accept=\"image/png,image/jpeg,image/webp\"\n                (selected)=\"uploadLogo($event)\"\n                [disabled]=\"logoUploading || logoRemoving\"\n               />\n              {{ logoUploading ? 'Uploading...' : form.logoUrl ? 'Replace logo' : 'Upload logo' }}\n            </label>\n            <ui-button\n              type=\"button\"\n              class=\"btn-link\"\n              *ngIf=\"form.logoUrl\"\n              (click)=\"removeLogo()\"\n              [disabled]=\"logoUploading || logoRemoving\"\n             variant=\"danger\">\n              {{ logoRemoving ? 'Removing...' : 'Remove logo' }}\n            </ui-button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Currency & Pricing</h3>\n    <div class=\"field-grid\">\n      <div class=\"field\">\n        <label for=\"store-settings-page.component-form-currency\">Currency</label>\n        <ui-select\n          id=\"store-settings-page.component-form-currency\"\n          [(ngModel)]=\"form.currency\"\n          (ngModelChange)=\"clearFieldError('currency')\"\n          [class.invalid-field]=\"fieldError('currency')\"\n        >\n          <option *ngIf=\"unknownCurrency() as code\" [value]=\"code\">Current: {{ code }}</option>\n          <option *ngFor=\"let option of currencyOptions\" [value]=\"option.code\">{{ option.label }}</option>\n        </ui-select>\n        <small class=\"field-error\" *ngIf=\"fieldError('currency')\">{{ fieldError('currency') }}</small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-tax-registration-number\">VAT/BIN Number</label>\n        <ui-input\n          id=\"store-tax-registration-number\"\n          type=\"text\"\n          [(ngModel)]=\"form.taxRegistrationNumber\"\n          placeholder=\"VAT/BIN shown on receipts\"\n         />\n      </div>\n      <div class=\"field\">\n        <label for=\"store-default-tax-country\">Default Tax Country</label>\n        <ui-input\n          id=\"store-default-tax-country\"\n          type=\"text\"\n          maxlength=\"2\"\n          [(ngModel)]=\"form.defaultTaxCountryCode\"\n          (ngModelChange)=\"clearFieldError('defaultTaxCountryCode')\"\n          [class.invalid-field]=\"fieldError('defaultTaxCountryCode')\"\n          placeholder=\"BD\"\n         />\n        <small class=\"field-error\" *ngIf=\"fieldError('defaultTaxCountryCode')\">\n          {{ fieldError('defaultTaxCountryCode') }}\n        </small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-default-tax-region\">Default Tax Region</label>\n        <ui-input\n          id=\"store-default-tax-region\"\n          type=\"text\"\n          [(ngModel)]=\"form.defaultTaxRegionCode\"\n          placeholder=\"Optional region/state\"\n         />\n      </div>\n      <div class=\"field\">\n        <label for=\"store-default-tax-mode\">Default Tax Mode</label>\n        <ui-select\n          id=\"store-default-tax-mode\"\n          [(ngModel)]=\"form.defaultTaxCalculationMode\"\n          (ngModelChange)=\"clearFieldError('defaultTaxCalculationMode')\"\n          [class.invalid-field]=\"fieldError('defaultTaxCalculationMode')\"\n        >\n          <option value=\"exclusive\">Exclusive</option>\n          <option value=\"inclusive\">Inclusive</option>\n        </ui-select>\n        <small class=\"field-error\" *ngIf=\"fieldError('defaultTaxCalculationMode')\">\n          {{ fieldError('defaultTaxCalculationMode') }}\n        </small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-receipt-tax-display\">Receipt Tax Display</label>\n        <ui-select\n          id=\"store-receipt-tax-display\"\n          [(ngModel)]=\"form.receiptTaxDisplayMode\"\n          (ngModelChange)=\"clearFieldError('receiptTaxDisplayMode')\"\n          [class.invalid-field]=\"fieldError('receiptTaxDisplayMode')\"\n        >\n          <option value=\"summary\">Summary</option>\n          <option value=\"line\">Line and summary</option>\n          <option value=\"hidden\">Hidden</option>\n        </ui-select>\n        <small class=\"field-error\" *ngIf=\"fieldError('receiptTaxDisplayMode')\">\n          {{ fieldError('receiptTaxDisplayMode') }}\n        </small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-tax-percent\">Legacy Tax Rate (%)</label>\n        <ui-number-input\n          id=\"store-tax-percent\"\n          type=\"number\"\n          [(ngModel)]=\"form.taxPercent\"\n          (ngModelChange)=\"clearFieldError('taxPercent')\"\n          [class.invalid-field]=\"fieldError('taxPercent')\"\n          min=\"0\"\n          max=\"100\"\n          step=\"0.01\"\n          placeholder=\"0.00\"\n         />\n        <small class=\"field-hint\">Compatibility only. Catalog Tax Rules now calculate effective VAT.</small>\n        <small class=\"field-error\" *ngIf=\"fieldError('taxPercent')\">{{ fieldError('taxPercent') }}</small>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"sticky-save-bar\">\n    <span>{{ hasUnsavedChanges() ? 'Unsaved settings changes' : 'Settings are up to date' }}</span>\n    <ui-button type=\"button\"  (click)=\"save()\" [disabled]=\"saving\" variant=\"primary\">\n      {{ saving ? 'Saving...' : 'Save Settings' }}\n    </ui-button>\n  </div>\n\n  <div class=\"error-msg\" *ngIf=\"errorMsg\">{{ errorMsg }}</div>\n  <div class=\"success-msg\" *ngIf=\"successMsg\">{{ successMsg }}</div>\n</div>\n\n<ui-loading-state  *ngIf=\"loading\">Loading settings...</ui-loading-state>\n\n<ui-image-resize-dialog\n  [open]=\"logoResizeOpen\"\n  [file]=\"logoResizeFile\"\n  title=\"Resize Store Logo\"\n  subtitle=\"Position the logo inside the square preview.\"\n  dialogLabel=\"Resize store logo\"\n  applyLabel=\"Use logo\"\n  outputLabel=\"Output\"\n  shape=\"square\"\n  [outputSize]=\"logoOutputSize\"\n  outputFileName=\"store-logo.jpg\"\n  outputMimeType=\"image/jpeg\"\n  [outputQuality]=\"0.9\"\n  [tips]=\"logoResizeTips\"\n  (closed)=\"closeLogoResize()\"\n  (resized)=\"applyLogoResize($event)\"\n/>\n","fulfillment":"<div class=\"form-card\" *ngIf=\"!loading\">\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Shipping</h3>\n    <div class=\"field-grid\">\n      <div class=\"field checkbox-field switch-field\">\n        <label class=\"switch-label\" for=\"store-delivery-enabled\">\n          <ui-checkbox id=\"store-delivery-enabled\" [(ngModel)]=\"form.deliveryEnabled\"  />\n          <span class=\"switch-control\"></span>\n          <span>Delivery enabled</span>\n        </label>\n      </div>\n      <div class=\"field checkbox-field switch-field\">\n        <label class=\"switch-label\" for=\"store-pickup-enabled\">\n          <ui-checkbox id=\"store-pickup-enabled\" [(ngModel)]=\"form.pickupEnabled\"  />\n          <span class=\"switch-control\"></span>\n          <span>Pickup enabled</span>\n        </label>\n      </div>\n      <div class=\"field checkbox-field switch-field\">\n        <label class=\"switch-label\" for=\"store-cod-enabled\">\n          <ui-checkbox id=\"store-cod-enabled\" [(ngModel)]=\"form.codEnabled\"  />\n          <span class=\"switch-control\"></span>\n          <span>COD enabled</span>\n        </label>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Rates and Limits</h3>\n    <div class=\"field-grid\">\n      <div class=\"field\">\n        <label for=\"store-settings-page.component-form-shippingcharge\">Flat Shipping Rate</label>\n        <div class=\"input-with-suffix\">\n          <ui-number-input\n            id=\"store-settings-page.component-form-shippingcharge\"\n            type=\"number\"\n            [(ngModel)]=\"form.shippingCharge\"\n            (ngModelChange)=\"clearFieldError('shippingCharge')\"\n            [class.invalid-field]=\"fieldError('shippingCharge')\"\n            min=\"0\"\n            step=\"0.01\"\n            placeholder=\"0.00\"\n           />\n          <span>{{ shippingCurrency() }}</span>\n        </div>\n        <small class=\"field-error\" *ngIf=\"fieldError('shippingCharge')\">{{ fieldError('shippingCharge') }}</small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-free-shipping-threshold\">Free Shipping Threshold</label>\n        <div class=\"input-with-suffix\">\n          <ui-number-input\n            id=\"store-free-shipping-threshold\"\n            type=\"number\"\n            [(ngModel)]=\"form.freeShippingThreshold\"\n            (ngModelChange)=\"clearFieldError('freeShippingThreshold')\"\n            [class.invalid-field]=\"fieldError('freeShippingThreshold')\"\n            min=\"0\"\n            step=\"0.01\"\n           />\n          <span>{{ shippingCurrency() }}</span>\n        </div>\n        <small class=\"field-error\" *ngIf=\"fieldError('freeShippingThreshold')\">{{ fieldError('freeShippingThreshold') }}</small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-min-delivery-amount\">Minimum Delivery Order</label>\n        <div class=\"input-with-suffix\">\n          <ui-number-input\n            id=\"store-min-delivery-amount\"\n            type=\"number\"\n            [(ngModel)]=\"form.minOrderAmountForDelivery\"\n            (ngModelChange)=\"clearFieldError('minOrderAmountForDelivery')\"\n            [class.invalid-field]=\"fieldError('minOrderAmountForDelivery')\"\n            min=\"0\"\n            step=\"0.01\"\n           />\n          <span>{{ shippingCurrency() }}</span>\n        </div>\n        <small class=\"field-error\" *ngIf=\"fieldError('minOrderAmountForDelivery')\">{{ fieldError('minOrderAmountForDelivery') }}</small>\n      </div>\n      <div class=\"field\">\n        <label for=\"store-max-cod-amount\">Maximum COD Order</label>\n        <div class=\"input-with-suffix\">\n          <ui-number-input\n            id=\"store-max-cod-amount\"\n            type=\"number\"\n            [(ngModel)]=\"form.maxOrderAmountForCod\"\n            (ngModelChange)=\"clearFieldError('maxOrderAmountForCod')\"\n            [class.invalid-field]=\"fieldError('maxOrderAmountForCod')\"\n            min=\"0\"\n            step=\"0.01\"\n           />\n          <span>{{ shippingCurrency() }}</span>\n        </div>\n        <small class=\"field-error\" *ngIf=\"fieldError('maxOrderAmountForCod')\">{{ fieldError('maxOrderAmountForCod') }}</small>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Delivery Areas</h3>\n    <div class=\"field-grid\">\n      <div class=\"field tag-field\">\n        <span class=\"field-label\">Allowed Countries</span>\n        <ui-autocomplete\n          id=\"store-allowed-countries\"\n          placeholder=\"Search country name or code\"\n          emptyText=\"No countries found.\"\n          loadingText=\"Loading countries...\"\n          [minSearchLength]=\"0\"\n          [loading]=\"shippingCountriesLoading\"\n          [options]=\"shippingCountryOptions\"\n          [value]=\"selectedShippingCountryOption\"\n          [query]=\"shippingCountrySearch\"\n          (search)=\"searchShippingCountries($event)\"\n          (queryChange)=\"shippingCountrySearch = $event\"\n          (valueChange)=\"selectShippingCountry($event)\"\n        ></ui-autocomplete>\n        <div class=\"chip-list\" *ngIf=\"form.allowedShippingCountries?.length; else noCountries\">\n          <ui-button\n            type=\"button\"\n            class=\"chip-remove\"\n            *ngFor=\"let country of form.allowedShippingCountries\"\n            (click)=\"removeShippingTag('allowedShippingCountries', country)\"\n            [attr.aria-label]=\"'Remove ' + country\"\n          >\n            {{ shippingCountryLabel(country) }} <span>x</span>\n          </ui-button>\n        </div>\n        <ng-template #noCountries><small class=\"field-hint\">No country restrictions.</small></ng-template>\n      </div>\n      <div class=\"field tag-field\">\n        <span class=\"field-label\">Allowed Regions</span>\n        <ui-autocomplete\n          id=\"store-allowed-regions\"\n          placeholder=\"Search division or region\"\n          emptyText=\"No regions found.\"\n          loadingText=\"Loading regions...\"\n          [minSearchLength]=\"0\"\n          [loading]=\"shippingRegionsLoading\"\n          [options]=\"shippingRegionOptions\"\n          [value]=\"selectedShippingRegionOption\"\n          [query]=\"shippingRegionSearch\"\n          (search)=\"searchShippingRegions($event)\"\n          (queryChange)=\"shippingRegionSearch = $event\"\n          (valueChange)=\"selectShippingRegion($event)\"\n        ></ui-autocomplete>\n        <div class=\"chip-list\" *ngIf=\"form.allowedShippingRegions?.length; else noRegions\">\n          <ui-button\n            type=\"button\"\n            class=\"chip-remove\"\n            *ngFor=\"let region of form.allowedShippingRegions\"\n            (click)=\"removeShippingTag('allowedShippingRegions', region)\"\n            [attr.aria-label]=\"'Remove ' + region\"\n          >\n            {{ shippingRegionLabel(region) }} <span>x</span>\n          </ui-button>\n        </div>\n        <ng-template #noRegions><small class=\"field-hint\">No region restrictions.</small></ng-template>\n      </div>\n      <div class=\"field tag-field field-wide\">\n        <span class=\"field-label\">Allowed Cities</span>\n        <ui-autocomplete\n          id=\"store-allowed-cities\"\n          placeholder=\"Search city\"\n          emptyText=\"No cities found.\"\n          loadingText=\"Loading cities...\"\n          [minSearchLength]=\"0\"\n          [loading]=\"shippingCitiesLoading\"\n          [options]=\"shippingCityOptions\"\n          [value]=\"selectedShippingCityOption\"\n          [query]=\"shippingCitySearch\"\n          (search)=\"searchShippingCities($event)\"\n          (queryChange)=\"shippingCitySearch = $event\"\n          (valueChange)=\"selectShippingCity($event)\"\n        ></ui-autocomplete>\n        <div class=\"chip-list\" *ngIf=\"form.allowedShippingCities?.length; else noCities\">\n          <ui-button\n            type=\"button\"\n            class=\"chip-remove\"\n            *ngFor=\"let city of form.allowedShippingCities\"\n            (click)=\"removeShippingTag('allowedShippingCities', city)\"\n            [attr.aria-label]=\"'Remove ' + city\"\n          >\n            {{ shippingCityLabel(city) }} <span>x</span>\n          </ui-button>\n        </div>\n        <ng-template #noCities><small class=\"field-hint\">No city restrictions.</small></ng-template>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Delivery Windows</h3>\n    <article class=\"enterprise-card\">\n      <div class=\"field-grid\">\n        <div class=\"field\">\n          <label for=\"store-delivery-window-label\">Label</label>\n          <ui-input id=\"store-delivery-window-label\" type=\"text\" [(ngModel)]=\"deliveryWindowDraft.label\" placeholder=\"Today\"  />\n        </div>\n        <div class=\"field\">\n          <label for=\"store-delivery-window-start\">Starts</label>\n          <ui-time-picker id=\"store-delivery-window-start\" [(ngModel)]=\"deliveryWindowDraft.startsAt\"  />\n        </div>\n        <div class=\"field\">\n          <label for=\"store-delivery-window-end\">Ends</label>\n          <ui-time-picker id=\"store-delivery-window-end\" [(ngModel)]=\"deliveryWindowDraft.endsAt\"  />\n        </div>\n      </div>\n      <div class=\"form-actions compact-actions\">\n        <ui-button type=\"button\"  (click)=\"addDeliveryWindow()\" variant=\"secondary\">Add delivery window</ui-button>\n      </div>\n      <div class=\"window-list\" *ngIf=\"form.deliveryWindows?.length; else noDeliveryWindows\">\n        <div class=\"window-row\" *ngFor=\"let window of form.deliveryWindows\">\n          <span>{{ window }}</span>\n          <ui-button type=\"button\" class=\"btn-link\" (click)=\"removeDeliveryWindow(window)\" variant=\"danger\">Remove</ui-button>\n        </div>\n      </div>\n      <ng-template #noDeliveryWindows>\n        <div class=\"empty-domains\">No delivery windows configured.</div>\n      </ng-template>\n    </article>\n  </div>\n\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Pickup Windows</h3>\n    <article class=\"enterprise-card\">\n      <div class=\"field-grid\">\n        <div class=\"field\">\n          <label>Name</label>\n          <ui-input type=\"text\" [(ngModel)]=\"pickupForm.name\"  />\n        </div>\n        <div class=\"field\">\n          <label>Day</label>\n          <ui-select [(ngModel)]=\"pickupForm.dayOfWeek\">\n            <option>Saturday</option>\n            <option>Sunday</option>\n            <option>Monday</option>\n            <option>Tuesday</option>\n            <option>Wednesday</option>\n            <option>Thursday</option>\n            <option>Friday</option>\n          </ui-select>\n        </div>\n        <div class=\"field\">\n          <label>Starts</label>\n          <ui-time-picker [(ngModel)]=\"pickupForm.startsAt\"  />\n        </div>\n        <div class=\"field\">\n          <label>Ends</label>\n          <ui-time-picker [(ngModel)]=\"pickupForm.endsAt\"  />\n        </div>\n        <div class=\"field\">\n          <label>Capacity</label>\n          <ui-number-input type=\"number\" min=\"0\" [(ngModel)]=\"pickupForm.capacity\"  />\n        </div>\n      </div>\n      <div class=\"form-actions compact-actions\">\n        <ui-button type=\"button\"  (click)=\"savePickupWindow()\" variant=\"secondary\">Create pickup window</ui-button>\n      </div>\n      <div class=\"compact-list\">\n        <div *ngFor=\"let window of pickupWindows\">\n          <strong>{{ window.name }}</strong>\n          <span>{{ window.dayOfWeek }} {{ window.startsAt }}-{{ window.endsAt }}</span>\n        </div>\n      </div>\n    </article>\n  </div>\n\n  <div class=\"sticky-save-bar\">\n    <span>{{ hasUnsavedChanges() ? 'Unsaved settings changes' : 'Settings are up to date' }}</span>\n    <ui-button type=\"button\"  (click)=\"save()\" [disabled]=\"saving\" variant=\"primary\">\n      {{ saving ? 'Saving...' : 'Save Settings' }}\n    </ui-button>\n  </div>\n\n  <div class=\"error-msg\" *ngIf=\"errorMsg\">{{ errorMsg }}</div>\n  <div class=\"success-msg\" *ngIf=\"successMsg\">{{ successMsg }}</div>\n</div>\n\n<ui-loading-state  *ngIf=\"loading\">Loading settings...</ui-loading-state>\n","storefront":"<div class=\"storefront-layout\" [class.has-readiness]=\"readiness || readinessLoading || readinessErrorMsg\">\n  <div class=\"storefront-main\">\n    <div class=\"form-card\" *ngIf=\"!loading\">\n      <div class=\"form-section\">\n        <div class=\"section-head-row\">\n          <h3 class=\"section-title\">Public Storefront</h3>\n          <ui-button-link\n            \n            *ngIf=\"previewStorefrontUrl() as previewUrl\"\n            [href]=\"previewUrl\"\n            target=\"_blank\"\n            rel=\"noopener\"\n           variant=\"secondary\">\n            Preview storefront\n          </ui-button-link>\n        </div>\n        <div class=\"field-grid\">\n          <div class=\"field checkbox-field switch-field\">\n            <label class=\"switch-label\" for=\"store-settings-page.component-form-ispublicstorepublished\">\n              <ui-checkbox\n                id=\"store-settings-page.component-form-ispublicstorepublished\"\n                [(ngModel)]=\"form.isPublicStorePublished\"\n               />\n              <span class=\"switch-control\"></span>\n              <span>Publish storefront</span>\n            </label>\n          </div>\n          <div class=\"field\">\n            <label for=\"store-public-slug\">Company storefront slug</label>\n            <ui-input\n              id=\"store-public-slug\"\n              type=\"text\"\n              [(ngModel)]=\"form.publicStorefrontSlug\"\n              (ngModelChange)=\"onSlugChange()\"\n              [class.invalid-field]=\"fieldError('publicStorefrontSlug')\"\n              placeholder=\"company-store\"\n             />\n            <small class=\"field-error\" *ngIf=\"fieldError('publicStorefrontSlug')\">{{ fieldError('publicStorefrontSlug') }}</small>\n          </div>\n          <div class=\"field field-wide\">\n            <span class=\"field-label\">\n              Canonical public URL <small>/public/{{ previewSlug }}/{{ '{' }}companySlug{{ '}' }}/shop</small>\n            </span>\n            <div class=\"readonly-url-row\">\n              <div class=\"readonly-url\">{{ storefrontCanonicalUrl() }}</div>\n              <ui-button type=\"button\" class=\"btn-compact\" (click)=\"copyStorefrontUrl('canonical', storefrontCanonicalUrl())\" variant=\"secondary\">\n                {{ copiedStorefrontUrlId === 'canonical' ? 'Copied' : 'Copy' }}\n              </ui-button>\n            </div>\n          </div>\n          <div class=\"field field-wide\" *ngIf=\"builtInSubdomainUrl\">\n            <span class=\"field-label\">Built-in subdomain URL</span>\n            <div class=\"readonly-url-row\">\n              <div class=\"readonly-url\">{{ builtInSubdomainUrl }}</div>\n              <ui-button type=\"button\" class=\"btn-compact\" (click)=\"copyStorefrontUrl('built-in', builtInSubdomainUrl)\" variant=\"secondary\">\n                {{ copiedStorefrontUrlId === 'built-in' ? 'Copied' : 'Copy' }}\n              </ui-button>\n            </div>\n          </div>\n          <div class=\"field field-wide\" *ngIf=\"primaryDomainUrl\">\n            <span class=\"field-label\">Primary domain URL</span>\n            <div class=\"readonly-url-row\">\n              <div class=\"readonly-url\">{{ primaryDomainUrl }}</div>\n              <ui-button type=\"button\" class=\"btn-compact\" (click)=\"copyStorefrontUrl('primary', primaryDomainUrl)\" variant=\"secondary\">\n                {{ copiedStorefrontUrlId === 'primary' ? 'Copied' : 'Copy' }}\n              </ui-button>\n            </div>\n          </div>\n          <div class=\"field\">\n            <label for=\"store-settings-page.component-form-publicheadline\">Public Headline</label>\n            <ui-input\n              id=\"store-settings-page.component-form-publicheadline\"\n              type=\"text\"\n              [(ngModel)]=\"form.publicHeadline\"\n              placeholder=\"Welcome to our store\"\n             />\n          </div>\n          <div class=\"field\">\n            <label for=\"store-contact-email\">Contact Email</label>\n            <ui-input\n              id=\"store-contact-email\"\n              type=\"email\"\n              [(ngModel)]=\"form.contactEmail\"\n              (ngModelChange)=\"clearFieldError('contactEmail')\"\n              [class.invalid-field]=\"fieldError('contactEmail')\"\n              placeholder=\"store@example.com\"\n             />\n            <small class=\"field-error\" *ngIf=\"fieldError('contactEmail')\">{{ fieldError('contactEmail') }}</small>\n          </div>\n          <div class=\"field\">\n            <label for=\"store-settings-page.component-form-contactphone\">Contact Phone</label>\n            <ui-input\n              id=\"store-settings-page.component-form-contactphone\"\n              type=\"text\"\n              [(ngModel)]=\"form.contactPhone\"\n              placeholder=\"+880...\"\n             />\n          </div>\n          <div class=\"field\">\n            <label for=\"store-website\">Website</label>\n            <ui-input\n              id=\"store-website\"\n              type=\"url\"\n              [(ngModel)]=\"form.website\"\n              (ngModelChange)=\"clearFieldError('website')\"\n              [class.invalid-field]=\"fieldError('website')\"\n              placeholder=\"https://example.com\"\n             />\n            <small class=\"field-error\" *ngIf=\"fieldError('website')\">{{ fieldError('website') }}</small>\n          </div>\n          <div class=\"field field-wide\">\n            <label for=\"store-public-description\">Public Description</label>\n            <ui-textarea\n              id=\"store-public-description\"\n              rows=\"4\"\n              [(ngModel)]=\"form.publicDescription\"\n              placeholder=\"Short text shown on the public storefront\"\n            ></ui-textarea>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"form-section\">\n        <h3 class=\"section-title\">Storefront Domains</h3>\n        <div class=\"field-grid\">\n          <div class=\"field\">\n            <label for=\"store-domain-host\">Domain or subdomain</label>\n            <ui-input id=\"store-domain-host\" type=\"text\" [(ngModel)]=\"domainHostName\" placeholder=\"shop.example.com\"  />\n          </div>\n          <div class=\"field checkbox-field switch-field\">\n            <label class=\"switch-label\" for=\"store-domain-primary\">\n              <ui-checkbox id=\"store-domain-primary\" [(ngModel)]=\"domainIsPrimary\"  />\n              <span class=\"switch-control\"></span>\n              <span>Set as primary after verification</span>\n            </label>\n          </div>\n        </div>\n        <div class=\"form-actions compact-actions\">\n          <ui-button type=\"button\"  (click)=\"addDomain()\" [disabled]=\"domainSaving || !domainHostName\" variant=\"secondary\">\n            {{ domainSaving ? 'Adding...' : 'Add Domain' }}\n          </ui-button>\n        </div>\n\n        <div class=\"domain-list\" *ngIf=\"domains.length; else noDomains\">\n          <div class=\"domain-row\" *ngFor=\"let domain of domains\">\n            <div>\n              <span class=\"domain-heading\">\n                <strong>{{ domain.hostName }}</strong>\n                <span class=\"status-badge\" [ngClass]=\"statusBadge(domain)\">{{ statusBadge(domain) }}</span>\n              </span>\n              <small>TXT {{ txtRecordValue(domain) }}</small>\n              <small *ngIf=\"domain.verificationStatus !== 'verified'\">DNS changes can take time before verification succeeds.</small>\n            </div>\n            <div class=\"domain-actions\">\n              <ui-button type=\"button\" class=\"btn-link\" (click)=\"copyTxtRecord(domain)\">\n                {{ copiedDomainId === domain.id ? 'Copied' : 'Copy TXT' }}\n              </ui-button>\n              <ui-button type=\"button\" class=\"btn-link\" (click)=\"verifyDomain(domain)\">Verify</ui-button>\n              <ui-button\n                type=\"button\"\n                class=\"btn-link\"\n                (click)=\"setPrimaryDomain(domain)\"\n                [disabled]=\"domain.verificationStatus !== 'verified' || domain.isPrimary\"\n                [title]=\"domain.verificationStatus !== 'verified' ? 'Verify this domain before setting it primary.' : ''\"\n              >\n                {{ domain.isPrimary ? 'Primary' : 'Set primary' }}\n              </ui-button>\n              <ui-button type=\"button\" class=\"btn-link\" (click)=\"deactivateDomain(domain)\" [disabled]=\"!domain.isActive\" variant=\"danger\">\n                Deactivate\n              </ui-button>\n            </div>\n          </div>\n        </div>\n        <ng-template #noDomains>\n          <div class=\"empty-domains\">No mapped domains yet. Add a verified domain when you are ready to use a custom storefront URL.</div>\n        </ng-template>\n      </div>\n\n      <div class=\"form-section\">\n        <h3 class=\"section-title\">Storefront Theme</h3>\n        <ui-radio-group\n          name=\"storefrontTheme\"\n          ariaLabel=\"Storefront theme\"\n          [options]=\"themeRadioOptions\"\n          [(ngModel)]=\"form.storefrontTheme\"\n        />\n      </div>\n\n      <div class=\"sticky-save-bar\">\n        <span>{{ hasUnsavedChanges() ? 'Unsaved settings changes' : 'Settings are up to date' }}</span>\n        <ui-button type=\"button\"  (click)=\"save()\" [disabled]=\"saving\" variant=\"primary\">\n          {{ saving ? 'Saving...' : 'Save Settings' }}\n        </ui-button>\n      </div>\n\n      <div class=\"error-msg\" *ngIf=\"errorMsg\">{{ errorMsg }}</div>\n      <div class=\"success-msg\" *ngIf=\"successMsg\">{{ successMsg }}</div>\n    </div>\n\n    <ui-loading-state  *ngIf=\"loading\">Loading settings...</ui-loading-state>\n  </div>\n\n  <aside class=\"storefront-aside\" *ngIf=\"readiness || readinessLoading || readinessErrorMsg\">\n    <section class=\"readiness-panel\">\n      <div class=\"readiness-head\">\n        <div>\n          <h3 class=\"section-title\">Storefront Readiness</h3>\n          <p>\n            {{\n              readinessLoading\n                ? 'Checking storefront setup...'\n                : readinessErrorMsg\n                  ? readinessErrorMsg\n                  : readiness?.isReady\n                    ? 'Ready to accept customer traffic.'\n                    : 'Complete setup before launch.'\n            }}\n          </p>\n        </div>\n        <span\n          class=\"readiness-status\"\n          [class.ready]=\"readiness?.isReady && !readinessLoading\"\n          [class.loading]=\"readinessLoading\"\n          [class.failed]=\"readinessErrorMsg\"\n        >\n          {{ readinessLoading ? 'Checking' : readinessErrorMsg ? 'Unavailable' : readiness?.isReady ? 'Ready' : 'Needs attention' }}\n        </span>\n      </div>\n      <div class=\"readiness-grid\" *ngIf=\"readiness && !readinessLoading\">\n        <div class=\"readiness-item\" *ngFor=\"let item of readiness.items\" [class.ready]=\"item.isReady\">\n          <span>{{ item.isReady ? 'OK' : '!' }}</span>\n          <div>\n            <strong>{{ item.label }}</strong>\n            <small *ngIf=\"item.message\">{{ item.message }}</small>\n          </div>\n        </div>\n      </div>\n      <div class=\"warning-list\" *ngIf=\"readiness?.warnings?.length\">\n        <span *ngFor=\"let warning of readiness?.warnings\">{{ warning }}</span>\n      </div>\n    </section>\n  </aside>\n</div>\n","content":"<div class=\"form-card\" *ngIf=\"!loading\">\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Storefront Content</h3>\n    <div class=\"content-admin-grid\">\n      <div class=\"policy-editor\">\n        <div class=\"policy-tabs\">\n          <ui-button\n            type=\"button\"\n            *ngFor=\"let option of policyOptions\"\n            [class.active]=\"selectedPolicySlug === option.slug\"\n            (click)=\"selectPolicy(option.slug)\"\n          >\n            {{ option.label }}\n          </ui-button>\n        </div>\n        <div class=\"field-grid\">\n          <div class=\"field\">\n            <label for=\"store-policy-title\">Policy title</label>\n            <ui-input id=\"store-policy-title\" type=\"text\" [(ngModel)]=\"policyForm.title\"  />\n          </div>\n          <div class=\"field checkbox-field switch-field\">\n            <label class=\"switch-label\" for=\"store-policy-published\">\n              <ui-checkbox id=\"store-policy-published\" [(ngModel)]=\"policyForm.isPublished\"  />\n              <span class=\"switch-control\"></span>\n              <span>Publish this page</span>\n            </label>\n          </div>\n          <div class=\"field\">\n            <label for=\"store-policy-meta-title\">SEO title</label>\n            <ui-input id=\"store-policy-meta-title\" type=\"text\" [(ngModel)]=\"policyForm.metaTitle\"  />\n          </div>\n          <div class=\"field\">\n            <label for=\"store-policy-meta-description\">SEO description</label>\n            <ui-input id=\"store-policy-meta-description\" type=\"text\" [(ngModel)]=\"policyForm.metaDescription\"  />\n          </div>\n          <div class=\"field field-wide\">\n            <label for=\"store-policy-body\">Policy content</label>\n            <ui-textarea id=\"store-policy-body\" rows=\"7\" [(ngModel)]=\"policyForm.bodyHtml\"></ui-textarea>\n            <small class=\"field-hint\">Simple HTML is supported for headings, paragraphs, and lists.</small>\n          </div>\n        </div>\n        <div class=\"form-actions compact-actions\">\n          <ui-button type=\"button\"  (click)=\"savePolicy()\" [disabled]=\"contentSaving\" variant=\"secondary\">\n            {{ contentSaving ? 'Saving...' : 'Save policy' }}\n          </ui-button>\n          <span class=\"field-hint\" *ngIf=\"contentLoading\">Loading policy pages...</span>\n        </div>\n      </div>\n\n      <article class=\"enterprise-card\">\n        <h4>Campaigns</h4>\n        <div class=\"field-grid\">\n          <div class=\"field\">\n            <label>Title</label>\n            <ui-input type=\"text\" [(ngModel)]=\"campaignForm.title\"  />\n          </div>\n          <div class=\"field\">\n            <label>Subtitle</label>\n            <ui-input type=\"text\" [(ngModel)]=\"campaignForm.subtitle\"  />\n          </div>\n          <div class=\"field\">\n            <label>Link URL</label>\n            <ui-input type=\"text\" [(ngModel)]=\"campaignForm.linkUrl\"  />\n          </div>\n          <div class=\"field\">\n            <label>Category slug</label>\n            <ui-input type=\"text\" [(ngModel)]=\"campaignForm.categorySlug\"  />\n          </div>\n        </div>\n        <div class=\"form-actions compact-actions\">\n          <ui-button type=\"button\"  (click)=\"saveCampaign()\" variant=\"secondary\">Create campaign</ui-button>\n        </div>\n        <div class=\"compact-list\">\n          <div *ngFor=\"let campaign of campaigns\">\n            <strong>{{ campaign.title }}</strong>\n            <span>{{ campaign.isActive ? 'Active' : 'Inactive' }}</span>\n          </div>\n        </div>\n      </article>\n    </div>\n  </div>\n\n  <div class=\"error-msg\" *ngIf=\"errorMsg\">{{ errorMsg }}</div>\n  <div class=\"success-msg\" *ngIf=\"successMsg\">{{ successMsg }}</div>\n</div>\n\n<ui-loading-state  *ngIf=\"loading\">Loading settings...</ui-loading-state>\n","customers":"<div class=\"form-card\" *ngIf=\"!loading\">\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Customer Accounts</h3>\n    <div class=\"field-grid\">\n      <div class=\"field\">\n        <label for=\"store-customer-verification-days\">Verification link validity</label>\n        <div class=\"input-with-suffix\">\n          <ui-number-input\n            id=\"store-customer-verification-days\"\n            type=\"number\"\n            min=\"1\"\n            max=\"30\"\n            step=\"1\"\n            [(ngModel)]=\"form.customerVerificationLinkValidityDays\"\n            (ngModelChange)=\"clearFieldError('customerVerificationLinkValidityDays')\"\n            [class.invalid-field]=\"fieldError('customerVerificationLinkValidityDays')\"\n           />\n          <span>days</span>\n        </div>\n        <small class=\"field-hint\">Customers must verify and set their password before this link expires.</small>\n        <small class=\"field-error\" *ngIf=\"fieldError('customerVerificationLinkValidityDays')\">{{ fieldError('customerVerificationLinkValidityDays') }}</small>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Reviews</h3>\n    <aside class=\"review-moderation\">\n      <div class=\"review-head\">\n        <strong>Reviews</strong>\n        <span>{{ reviewLoading ? 'Loading...' : reviews.length }}</span>\n      </div>\n      <div class=\"review-filter\">\n        <ui-button\n          type=\"button\"\n          *ngFor=\"let option of reviewStatusOptions\"\n          [class.active]=\"reviewStatus === option.value\"\n          (click)=\"selectReviewStatus(option.value)\"\n        >\n          {{ option.label }}\n        </ui-button>\n      </div>\n      <div class=\"review-row\" *ngFor=\"let review of reviews\">\n        <div>\n          <strong>{{ review.productName }}</strong>\n          <span>{{ review.customerName }} - {{ review.rating }}/5</span>\n          <p>{{ review.title }}</p>\n        </div>\n        <div class=\"review-actions\">\n          <ui-button type=\"button\" class=\"btn-link\" (click)=\"moderateReview(review, 'published')\">Publish</ui-button>\n          <ui-button type=\"button\" class=\"btn-link\" (click)=\"moderateReview(review, 'rejected')\" variant=\"danger\">Reject</ui-button>\n        </div>\n      </div>\n      <div class=\"empty-domains\" *ngIf=\"!reviewLoading && !reviews.length\">No reviews found for this filter.</div>\n    </aside>\n  </div>\n\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Return Requests</h3>\n    <article class=\"enterprise-card\">\n      <div class=\"compact-list\">\n        <div *ngFor=\"let request of returnRequests\">\n          <strong>{{ request.orderNumber }}</strong>\n          <span>{{ request.reason }} - {{ request.status }}</span>\n          <span class=\"row-actions\">\n            <ui-button type=\"button\" class=\"btn-link\" (click)=\"moderateReturn(request, true)\">Approve</ui-button>\n            <ui-button type=\"button\" class=\"btn-link\" (click)=\"moderateReturn(request, false)\" variant=\"danger\">Reject</ui-button>\n          </span>\n        </div>\n        <div class=\"empty-domains\" *ngIf=\"!returnRequests.length\">No pending return requests.</div>\n      </div>\n    </article>\n  </div>\n\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Segments and Ledgers</h3>\n    <article class=\"enterprise-card\">\n      <div class=\"field-grid\">\n        <div class=\"field\">\n          <label>Segment name</label>\n          <ui-input type=\"text\" [(ngModel)]=\"segmentForm.name\"  />\n        </div>\n        <div class=\"field\">\n          <label>Segment code</label>\n          <ui-input type=\"text\" [(ngModel)]=\"segmentForm.code\"  />\n        </div>\n      </div>\n      <ui-button type=\"button\"  (click)=\"saveSegment()\" variant=\"secondary\">Create segment</ui-button>\n      <div class=\"compact-list\">\n        <div *ngFor=\"let segment of segments\">\n          <strong>{{ segment.name }}</strong>\n          <span>{{ segment.code }}</span>\n        </div>\n      </div>\n      <div class=\"field-grid ledger-form\">\n        <div class=\"field\">\n          <label>Customer id</label>\n          <ui-input type=\"text\" [(ngModel)]=\"ledgerForm.customerId\"  />\n        </div>\n        <div class=\"field\">\n          <label>Reason</label>\n          <ui-input type=\"text\" [(ngModel)]=\"ledgerForm.reason\"  />\n        </div>\n        <div class=\"field\">\n          <label>Points delta</label>\n          <ui-number-input type=\"number\" [(ngModel)]=\"ledgerForm.pointsDelta\"  />\n        </div>\n        <div class=\"field\">\n          <label>Credit delta</label>\n          <ui-number-input type=\"number\" step=\"0.01\" [(ngModel)]=\"ledgerForm.amountDelta\"  />\n        </div>\n      </div>\n      <div class=\"form-actions compact-actions\">\n        <ui-button type=\"button\"  (click)=\"adjustLoyalty()\" variant=\"secondary\">Post loyalty</ui-button>\n        <ui-button type=\"button\"  (click)=\"adjustStoreCredit()\" variant=\"secondary\">Post store credit</ui-button>\n      </div>\n    </article>\n  </div>\n\n  <div class=\"sticky-save-bar\">\n    <span>{{ hasUnsavedChanges() ? 'Unsaved settings changes' : 'Settings are up to date' }}</span>\n    <ui-button type=\"button\"  (click)=\"save()\" [disabled]=\"saving\" variant=\"primary\">\n      {{ saving ? 'Saving...' : 'Save Settings' }}\n    </ui-button>\n  </div>\n\n  <div class=\"error-msg\" *ngIf=\"errorMsg\">{{ errorMsg }}</div>\n  <div class=\"success-msg\" *ngIf=\"successMsg\">{{ successMsg }}</div>\n</div>\n\n<ui-loading-state  *ngIf=\"loading\">Loading settings...</ui-loading-state>\n","enterprise":"<div class=\"form-card\" *ngIf=\"!loading\">\n  <div class=\"form-section\">\n    <h3 class=\"section-title\">Enterprise Storefront</h3>\n    <div class=\"enterprise-grid\">\n      <article class=\"enterprise-card\">\n        <h4>Recovery, returns, loyalty</h4>\n        <div class=\"field-grid\">\n          <label class=\"switch-label\">\n            <ui-checkbox [(ngModel)]=\"enterpriseForm.cartRecoveryEnabled\"  />\n            <span class=\"switch-control\"></span>\n            <span>Cart recovery enabled</span>\n          </label>\n          <label class=\"switch-label\">\n            <ui-checkbox [(ngModel)]=\"enterpriseForm.loyaltyEnabled\"  />\n            <span class=\"switch-control\"></span>\n            <span>Loyalty enabled</span>\n          </label>\n          <label class=\"switch-label\">\n            <ui-checkbox [(ngModel)]=\"enterpriseForm.storeCreditEnabled\"  />\n            <span class=\"switch-control\"></span>\n            <span>Store credit enabled</span>\n          </label>\n          <div class=\"field\">\n            <label>First reminder hours</label>\n            <ui-number-input type=\"number\" min=\"1\" [(ngModel)]=\"enterpriseForm.cartRecoveryFirstReminderHours\"  />\n          </div>\n          <div class=\"field\">\n            <label>Second reminder hours</label>\n            <ui-number-input type=\"number\" min=\"1\" [(ngModel)]=\"enterpriseForm.cartRecoverySecondReminderHours\"  />\n          </div>\n          <div class=\"field\">\n            <label>Restore token days</label>\n            <ui-number-input type=\"number\" min=\"1\" max=\"30\" [(ngModel)]=\"enterpriseForm.cartRecoveryRestoreTokenDays\"  />\n          </div>\n          <div class=\"field\">\n            <label>Return window days</label>\n            <ui-number-input type=\"number\" min=\"0\" max=\"30\" [(ngModel)]=\"enterpriseForm.returnWindowDays\"  />\n          </div>\n          <div class=\"field\">\n            <label>Loyalty earn rate</label>\n            <ui-number-input type=\"number\" min=\"0\" step=\"0.01\" [(ngModel)]=\"enterpriseForm.loyaltyEarnRate\"  />\n          </div>\n        </div>\n        <div class=\"form-actions compact-actions\">\n          <ui-button type=\"button\"  (click)=\"saveEnterpriseSettings()\" [disabled]=\"enterpriseSaving\" variant=\"secondary\">\n            {{ enterpriseSaving ? 'Saving...' : 'Save enterprise settings' }}\n          </ui-button>\n          <span class=\"field-hint\" *ngIf=\"enterpriseLoading\">Loading enterprise settings...</span>\n        </div>\n      </article>\n\n      <article class=\"enterprise-card\">\n        <h4>Analytics</h4>\n        <div class=\"analytics-grid\">\n          <div><span>Product views</span><strong>{{ analytics?.productViews ?? 0 }}</strong></div>\n          <div><span>Searches</span><strong>{{ analytics?.searches ?? 0 }}</strong></div>\n          <div><span>Add to cart</span><strong>{{ analytics?.addToCart ?? 0 }}</strong></div>\n          <div><span>Purchases</span><strong>{{ analytics?.purchases ?? 0 }}</strong></div>\n          <div><span>Recovery restores</span><strong>{{ analytics?.cartRecoveryRestores ?? 0 }}</strong></div>\n          <div><span>Conversion</span><strong>{{ (analytics?.conversionRate ?? 0) | number: '1.1-2' }}%</strong></div>\n        </div>\n      </article>\n    </div>\n  </div>\n\n  <div class=\"error-msg\" *ngIf=\"errorMsg\">{{ errorMsg }}</div>\n  <div class=\"success-msg\" *ngIf=\"successMsg\">{{ successMsg }}</div>\n</div>\n\n<ui-loading-state  *ngIf=\"loading\">Loading settings...</ui-loading-state>\n"}
