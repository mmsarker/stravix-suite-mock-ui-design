{"template":"<ui-page class=\"school-management-page\" surface=\"plain\">\n  <ui-page-header kicker=\"School Management\" title=\"Attendance Workspace Page\">\n    <app-school-academic-context meta branchEnabled branchRequired (contextChanged)=\"onContextChanged()\" />\n  </ui-page-header>\n  <ui-section-card class=\"attendance-workspace\" aria-label=\"Attendance workspace\" [title]=\"pageTitle\" [subtitle]=\"pageSubtitle\">\n    @if (!hideTabs) {\n    <nav class=\"tabs\">\n      <ui-button variant=\"ghost\" type=\"button\" [class.active]=\"activeTab() === 'marking'\" (click)=\"setTab('marking')\"\n        >Daily Marking</ui-button\n      >\n      <ui-button variant=\"ghost\" type=\"button\" [class.active]=\"activeTab() === 'bulk'\" (click)=\"setTab('bulk')\">Bulk Upload</ui-button>\n      <ui-button variant=\"ghost\" type=\"button\" [class.active]=\"activeTab() === 'reports'\" (click)=\"setTab('reports')\">Reports</ui-button>\n      <ui-button variant=\"ghost\" type=\"button\" [class.active]=\"activeTab() === 'edits'\" (click)=\"setTab('edits')\">\n        Edit Requests @if (pendingEditCount() > 0) {\n        <ui-badge [label]=\"pendingEditCount()\" />\n        }\n      </ui-button>\n      <ui-button variant=\"ghost\" type=\"button\" [class.active]=\"activeTab() === 'policy'\" (click)=\"setTab('policy')\">\n        Policy & Holidays\n      </ui-button>\n      <ui-button variant=\"ghost\" type=\"button\" [class.active]=\"activeTab() === 'notifications'\" (click)=\"setTab('notifications')\">\n        Notifications\n      </ui-button>\n    </nav>\n    }\n\n    <!-- ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ Daily Marking ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ -->\n    @if (activeTab() === 'marking') {\n    <div class=\"tab-panel\">\n      <div class=\"hint-bar\">\n        <span\n          >Select class and section, then click <strong>Load Existing</strong> to prefill already-saved records for that date. Adjust\n          individual statuses and click <strong>Save Attendance</strong> to submit.</span\n        >\n      </div>\n\n      <div class=\"filters-grid\">\n        <label for=\"attendance-workspace-page.template-markdate\">\n          Date\n          <ui-date-picker\n            id=\"attendance-workspace-page.template-markdate\"\n            type=\"date\"\n            [(ngModel)]=\"markDate\"\n            (ngModelChange)=\"onMarkDateChange()\"\n          />\n        </label>\n        <label>\n          Class\n          <ui-select [(ngModel)]=\"selectedLevelId\" (ngModelChange)=\"onLevelChange()\">\n            <option value=\"\">Select class</option>\n            @for (level of levels; track level.id) {\n            <option [value]=\"level.id\">{{ level.name }} ({{ level.code }})</option>\n            }\n          </ui-select>\n        </label>\n        <label>\n          Section\n          <ui-select [(ngModel)]=\"selectedSectionId\" (ngModelChange)=\"loadStudents()\" [disabled]=\"!selectedLevelId\">\n            <option value=\"\">Select section</option>\n            @for (section of sections; track section.id) {\n            <option [value]=\"section.id\">{{ section.name }}</option>\n            }\n          </ui-select>\n        </label>\n        <label>\n          Subject\n          <ui-select\n            [(ngModel)]=\"selectedSubjectCode\"\n            (ngModelChange)=\"loadDaily()\"\n            [disabled]=\"!selectedLevelId || !markingSubjects().length\"\n          >\n            <option value=\"\">Select subject</option>\n            @for (subject of markingSubjects(); track subject.id) {\n            <option [value]=\"subject.code\">{{ subject.code }} — {{ subject.nameEn }}</option>\n            }\n          </ui-select>\n        </label>\n      </div>\n\n      @if (isMarkingLocked()) {\n      <p class=\"lock-notice\">\n        ÃƒÆ’Ã‚Â°Ãƒâ€¦Ã‚Â¸ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ Attendance is locked for this date ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â the\n        lock-after-days policy has passed. Contact an admin to unlock.\n      </p>\n      }\n\n      <div class=\"row-actions\">\n        <ui-button variant=\"ghost\" type=\"button\" (click)=\"loadDaily()\" [disabled]=\"!canLoadMarking()\">Load Existing</ui-button>\n        @if (markRows.length && !isMarkingLocked() && canUpdateMarking()) {\n        <ui-button variant=\"ghost\" type=\"button\" (click)=\"markAll('present')\">ÃƒÆ’Ã‚Â¢Ãƒâ€¦Ã¢â‚¬Å“ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â All Present</ui-button>\n        <ui-button variant=\"ghost\" type=\"button\" (click)=\"markAll('absent')\">ÃƒÆ’Ã‚Â¢Ãƒâ€¦Ã¢â‚¬Å“Ãƒâ€¹Ã…â€œ All Absent</ui-button>\n        }\n        <ui-button variant=\"primary\" type=\"button\" (click)=\"saveMarking()\" [disabled]=\"!canSaveMarking() || savingMarking\" class=\"primary\">\n          {{ savingMarking ? 'SavingÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¦' : 'Save Attendance' }}\n        </ui-button>\n      </div>\n\n      @if (markingError) {\n      <ui-alert variant=\"error\">{{ markingError }}</ui-alert>\n      } @if (!markRows.length) {\n      <p class=\"empty-hint\">Select class, section and subject above to load the student list.</p>\n      } @else {\n      <div class=\"summary-row\">\n        <ui-badge class=\"present-chip\">Present: {{ countStatus('present') }}</ui-badge>\n        <ui-badge class=\"absent-chip\">Absent: {{ countStatus('absent') }}</ui-badge>\n        <ui-badge class=\"late-chip\">Late: {{ countStatus('late') }}</ui-badge>\n        <ui-badge class=\"leave-chip\">Leave: {{ countStatus('leave') }}</ui-badge>\n        <ui-badge class=\"neutral-chip\">Total: {{ markRows.length }}</ui-badge>\n      </div>\n      <ui-data-table [pagination]=\"false\"\n        ><table>\n          <thead>\n            <tr>\n              <th>#</th>\n              <th>Student</th>\n              <th>Status</th>\n              <th>Last Saved</th>\n              <th>Updated By</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (row of markRows; track row.studentId; let i = $index) {\n            <tr>\n              <td class=\"idx\">{{ i + 1 }}</td>\n              <td>{{ row.studentName }}</td>\n              <td>\n                <div class=\"status-toggles\">\n                  <ui-button\n                    variant=\"ghost\"\n                    type=\"button\"\n                    [class]=\"'st-btn p' + (row.status === 'present' ? ' active-p' : '')\"\n                    (click)=\"setStatus(row, 'present')\"\n                    [disabled]=\"!canUpdateMarking() || isMarkingLocked()\"\n                  >\n                    P\n                  </ui-button>\n                  <ui-button\n                    variant=\"ghost\"\n                    type=\"button\"\n                    [class]=\"'st-btn a' + (row.status === 'absent' ? ' active-a' : '')\"\n                    (click)=\"setStatus(row, 'absent')\"\n                    [disabled]=\"!canUpdateMarking() || isMarkingLocked()\"\n                  >\n                    A\n                  </ui-button>\n                  <ui-button\n                    variant=\"ghost\"\n                    type=\"button\"\n                    [class]=\"'st-btn l' + (row.status === 'late' ? ' active-l' : '')\"\n                    (click)=\"setStatus(row, 'late')\"\n                    [disabled]=\"!canUpdateMarking() || isMarkingLocked()\"\n                  >\n                    L\n                  </ui-button>\n                  <ui-button\n                    variant=\"ghost\"\n                    type=\"button\"\n                    [class]=\"'st-btn lv' + (row.status === 'leave' ? ' active-lv' : '')\"\n                    (click)=\"setStatus(row, 'leave')\"\n                    [disabled]=\"!canUpdateMarking() || isMarkingLocked()\"\n                  >\n                    Lv\n                  </ui-button>\n                </div>\n              </td>\n              <td class=\"saved-at\">\n                {{ row.markedAtUtc ? (row.markedAtUtc | date:'MMM d, HH:mm') : 'ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â' }}\n              </td>\n              <td class=\"saved-at\">{{ row.markedByUserId || 'ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â' }}</td>\n            </tr>\n            }\n          </tbody>\n        </table></ui-data-table\n      >\n      }\n    </div>\n    }\n\n    <!-- ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ Bulk Upload ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ -->\n    @if (activeTab() === 'bulk') {\n    <div class=\"tab-panel\">\n      <div class=\"hint-bar\">\n        <span\n          >Upload a CSV file to mark attendance for many students at once. Use the same <strong>date / class / section</strong> filters as\n          daily attendance. Subject selection is not required.</span\n        >\n      </div>\n\n      <div class=\"section-block\">\n        <h4>Step 1 - Choose class context</h4>\n        <div class=\"filters-grid\">\n          <label for=\"attendance-workspace-page.template-markdate-2\">\n            Date\n            <ui-date-picker id=\"attendance-workspace-page.template-markdate-2\" type=\"date\" [(ngModel)]=\"markDate\" />\n          </label>\n          <label>\n            Class\n            <ui-select [(ngModel)]=\"selectedLevelId\" (ngModelChange)=\"onLevelChange()\">\n              <option value=\"\">Select class</option>\n              @for (level of levels; track level.id) {\n              <option [value]=\"level.id\">{{ level.name }} ({{ level.code }})</option>\n              }\n            </ui-select>\n          </label>\n          <label>\n            Section\n            <ui-select [(ngModel)]=\"selectedSectionId\" [disabled]=\"!selectedLevelId\">\n              <option value=\"\">Select section</option>\n              @for (section of sections; track section.id) {\n              <option [value]=\"section.id\">{{ section.name }}</option>\n              }\n            </ui-select>\n          </label>\n          <label>\n            Subject\n            <ui-select [(ngModel)]=\"selectedSubjectCode\" [disabled]=\"!selectedLevelId || !markingSubjects().length\">\n              <option value=\"\">Select subject</option>\n              @for (subject of markingSubjects(); track subject.id) {\n              <option [value]=\"subject.code\">{{ subject.code }} - {{ subject.nameEn }}</option>\n              }\n            </ui-select>\n          </label>\n        </div>\n      </div>\n\n      <div class=\"section-block\">\n        <h4>Step 2 - Download the CSV template</h4>\n        <p class=\"muted\">\n          The template contains the required columns: <code>studentId,status</code>. Valid statuses: <code>present</code>,\n          <code>absent</code>, <code>late</code>, <code>leave</code>.\n        </p>\n        <ui-button variant=\"ghost\" type=\"button\" (click)=\"downloadTemplate()\" [disabled]=\"!canBulkView()\"> Download Template </ui-button>\n      </div>\n\n      <div class=\"section-block\">\n        <h4>Step 3 - Upload filled CSV</h4>\n        <ui-input type=\"file\" accept=\".csv,text/csv\" (change)=\"onFileChange($event)\" />\n        <div class=\"row-actions\">\n          <ui-button\n            variant=\"primary\"\n            type=\"button\"\n            (click)=\"uploadBulk()\"\n            [disabled]=\"!canBulkUpdate() || !selectedLevelId || !selectedSectionId || !selectedSubjectCode || !bulkFile\"\n            class=\"primary\"\n          >\n            Upload\n          </ui-button>\n        </div>\n      </div>\n    </div>\n    }\n\n    <!-- ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ Reports ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ -->\n    @if (activeTab() === 'reports') {\n    <div class=\"tab-panel\">\n      <div class=\"hint-bar\">\n        <span\n          >Filter by date range, class, section or a specific student to generate a summary report. Rows highlighted in\n          <strong class=\"warn-inline\">red</strong> are below the minimum attendance threshold. Export to CSV for further analysis.</span\n        >\n      </div>\n\n      <div class=\"filters-grid four-col\">\n        <label for=\"attendance-workspace-page.template-reportfrom\">\n          From\n          <ui-date-picker id=\"attendance-workspace-page.template-reportfrom\" type=\"date\" [(ngModel)]=\"reportFrom\" />\n        </label>\n        <label for=\"attendance-workspace-page.template-reportto\">\n          To\n          <ui-date-picker id=\"attendance-workspace-page.template-reportto\" type=\"date\" [(ngModel)]=\"reportTo\" />\n        </label>\n        <label>\n          Class (optional)\n          <ui-select [(ngModel)]=\"reportLevelId\" (ngModelChange)=\"onReportLevelChange()\">\n            <option value=\"\">All classes</option>\n            @for (level of levels; track level.id) {\n            <option [value]=\"level.id\">{{ level.name }}</option>\n            }\n          </ui-select>\n        </label>\n        <label>\n          Section (optional)\n          <ui-select [(ngModel)]=\"reportSectionId\" [disabled]=\"!reportLevelId\">\n            <option value=\"\">All sections</option>\n            @for (section of reportSections; track section.id) {\n            <option [value]=\"section.id\">{{ section.name }}</option>\n            }\n          </ui-select>\n        </label>\n        <label class=\"span-full\">\n          Student Search (optional)\n          <ui-input\n            [(ngModel)]=\"reportStudentQuery\"\n            (ngModelChange)=\"onReportStudentQueryChange()\"\n            placeholder=\"Search by student name or email\"\n          />\n          <span class=\"field-hint\">Search for a student, then select one result to load a detailed attendance report.</span>\n        </label>\n        @if (selectedReportStudentLabel) {\n        <div class=\"span-full selected-student\">\n          <ui-badge class=\"neutral-chip\">Selected: {{ selectedReportStudentLabel }}</ui-badge>\n          <ui-button variant=\"ghost\" size=\"sm\" type=\"button\" class=\"sm\" (click)=\"clearReportStudent()\">Clear</ui-button>\n        </div>\n        } @if (reportStudentResults.length) {\n        <div class=\"span-full search-results\">\n          @for (student of reportStudentResults; track student.id) {\n          <ui-button variant=\"ghost\" type=\"button\" class=\"search-result-btn\" (click)=\"selectReportStudent(student)\">\n            {{ student.firstName }} {{ student.lastName }} | {{ student.email || 'No email' }}\n          </ui-button>\n          }\n        </div>\n        }\n      </div>\n\n      <div class=\"row-actions\">\n        <ui-button variant=\"primary\" type=\"button\" (click)=\"loadReports()\" [disabled]=\"!canReportsView()\" class=\"primary\"\n          >Load Reports</ui-button\n        >\n        <ui-button variant=\"ghost\" type=\"button\" (click)=\"exportReports()\" [disabled]=\"!canReportsView() || !reports.length\">\n          ÃƒÆ’Ã‚Â¢Ãƒâ€šÃ‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¡ Export CSV\n        </ui-button>\n      </div>\n\n      @if (reportError) {\n      <ui-alert variant=\"error\">{{ reportError }}</ui-alert>\n      } @if (!reports.length) {\n      <p class=\"empty-hint\">No report data. Apply filters and click Load Reports.</p>\n      } @else {\n      <p class=\"result-count\">{{ reports.length }} student{{ reports.length !== 1 ? 's' : '' }} found</p>\n      <ui-data-table [pagination]=\"false\"\n        ><table>\n          <thead>\n            <tr>\n              <th>Student</th>\n              <th>Class / Section</th>\n              <th>Sessions</th>\n              <th>Present</th>\n              <th>Absent</th>\n              <th>Late</th>\n              <th>Leave</th>\n              <th>Attendance %</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (r of reports; track r.studentId) {\n            <tr [class.below-threshold]=\"r.summary.isBelowThreshold\">\n              <td>{{ r.studentName }}</td>\n              <td>{{ r.className }} {{ r.section }}</td>\n              <td>{{ r.summary.totalSessions }}</td>\n              <td>{{ r.summary.presentCount }}</td>\n              <td>{{ r.summary.absentCount }}</td>\n              <td>{{ r.summary.lateCount }}</td>\n              <td>{{ r.summary.leaveCount }}</td>\n              <td [class.warn]=\"r.summary.isBelowThreshold\">\n                {{ r.summary.percentage }}% @if (r.summary.isBelowThreshold) {\n                <span class=\"warn-label\">Below threshold</span> }\n              </td>\n            </tr>\n            }\n          </tbody>\n        </table></ui-data-table\n      >\n      }\n    </div>\n    }\n\n    <!-- ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ Edit Requests ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ -->\n    @if (activeTab() === 'edits') {\n    <div class=\"tab-panel\">\n      <div class=\"hint-bar\">\n        @if (isStudentUser()) {\n        <span\n          >Select one of your attendance records, request the corrected status, and track the activity log. Teachers and admins receive the\n          request from the same workflow.</span\n        >\n        } @else {\n        <span\n          >Review attendance correction requests from students, approve or reject them, and follow the shared activity log for each\n          change.</span\n        >\n        }\n      </div>\n\n      @if (isStudentUser()) {\n      <div class=\"section-block\">\n        <div class=\"section-row\">\n          <h4>My attendance records</h4>\n          <div class=\"row-actions tight\">\n            <ui-input type=\"month\" [(ngModel)]=\"myEditMonth\" />\n            <ui-button variant=\"ghost\" size=\"sm\" type=\"button\" class=\"sm\" (click)=\"loadMyAttendanceRecords()\">Load</ui-button>\n          </div>\n        </div>\n        @if (!myAttendanceRecords.length) {\n        <p class=\"empty-hint\">No attendance records found for the selected month.</p>\n        } @else {\n        <ui-data-table [pagination]=\"false\"\n          ><table>\n            <thead>\n              <tr>\n                <th>Date</th>\n                <th>Status</th>\n                <th>Action</th>\n              </tr>\n            </thead>\n            <tbody>\n              @for (record of myAttendanceRecords; track record.id) {\n              <tr>\n                <td>{{ formatDisplayDate(record.dateUtc) }}</td>\n                <td><span class=\"status-chip\">{{ record.status }}</span></td>\n                <td>\n                  <ui-button variant=\"ghost\" size=\"sm\" type=\"button\" class=\"sm\" (click)=\"selectAttendanceRecordForEdit(record)\">\n                    Request Change\n                  </ui-button>\n                </td>\n              </tr>\n              }\n            </tbody>\n          </table></ui-data-table\n        >\n        }\n      </div>\n      } @if (canRequestAttendanceChange()) {\n      <div class=\"section-block\">\n        <h4>{{ isStudentUser() ? 'Request an attendance change' : 'Submit a new edit request' }}</h4>\n        <div class=\"filters-grid\">\n          <label class=\"span-full\" for=\"attendance-workspace-page.template-neweditdate\">\n            Attendance Date\n            <ui-date-picker id=\"attendance-workspace-page.template-neweditdate\" type=\"date\" [(ngModel)]=\"newEditDate\" />\n            <span class=\"field-hint\"\n              >{{ isStudentUser() ? 'Choose a row above to autofill the date you want to correct.' : 'Enter the student attendance date that\n              should be corrected.' }}</span\n            >\n          </label>\n          <label>\n            Change status to\n            <ui-select [(ngModel)]=\"newEditToStatus\">\n              <option value=\"present\">Present</option>\n              <option value=\"absent\">Absent</option>\n              <option value=\"late\">Late</option>\n              <option value=\"leave\">Leave</option>\n            </ui-select>\n          </label>\n          <label for=\"attendance-workspace-page.template-neweditreason\">\n            Reason\n            <ui-input\n              id=\"attendance-workspace-page.template-neweditreason\"\n              [(ngModel)]=\"newEditReason\"\n              placeholder=\"Explain why this change is needed\"\n            />\n          </label>\n        </div>\n        <div class=\"row-actions\">\n          <ui-button\n            variant=\"primary\"\n            type=\"button\"\n            (click)=\"createEditRequest()\"\n            [disabled]=\"!newEditDate || !newEditReason.trim()\"\n            class=\"primary\"\n          >\n            Submit Request\n          </ui-button>\n        </div>\n      </div>\n      }\n\n      <div class=\"section-block\">\n        <div class=\"section-row\">\n          <h4>{{ isStudentUser() ? 'My edit requests' : 'All edit requests' }}</h4>\n        </div>\n        @if (!editRequests.length) {\n        <p class=\"empty-hint\">No edit requests found.</p>\n        } @else {\n        <ui-data-table [pagination]=\"false\"\n          ><table>\n            <thead>\n              <tr>\n                <th>Student</th>\n                <th>Date</th>\n                <th>Change</th>\n                <th>Reason</th>\n                <th>Status</th>\n                <th>Submitted</th>\n                @if (canEditApprove()) {\n                <th>Actions</th>\n                }\n              </tr>\n            </thead>\n            <tbody>\n              @for (req of editRequests; track req.id) {\n              <tr>\n                <td>{{ req.studentName || req.studentId }}</td>\n                <td>{{ formatDisplayDate(req.dateUtc) }}</td>\n                <td>\n                  <span class=\"status-from\">{{ req.fromStatus }}</span>\n                  <span class=\"arrow\">ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢</span>\n                  <span class=\"status-to\">{{ req.toStatus }}</span>\n                </td>\n                <td>{{ req.reason }}</td>\n                <td><span [class]=\"'status-chip ' + req.status\">{{ req.status }}</span></td>\n                <td>{{ req.createdAtUtc | date:'MMM d, HH:mm' }}</td>\n                @if (canEditApprove()) {\n                <td>\n                  @if (req.status === 'pending') {\n                  <div class=\"row-actions tight\">\n                    <ui-button variant=\"ghost\" type=\"button\" class=\"approve-btn\" (click)=\"decideEdit(req.id, true)\">Approve</ui-button>\n                    <ui-button variant=\"ghost\" type=\"button\" class=\"reject-btn\" (click)=\"decideEdit(req.id, false)\">Reject</ui-button>\n                  </div>\n                  } @else {\n                  <span class=\"muted\">ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â</span>\n                  }\n                </td>\n                }\n              </tr>\n              }\n            </tbody>\n          </table></ui-data-table\n        >\n        }\n      </div>\n\n      <div class=\"section-block\">\n        <div class=\"section-row\">\n          <h4>Attendance change activity log</h4>\n        </div>\n        @if (!notifications.length) {\n        <p class=\"empty-hint\">No activity found yet.</p>\n        } @else {\n        <ui-data-table [pagination]=\"false\"\n          ><table>\n            <thead>\n              <tr>\n                <th>Time</th>\n                <th>Event</th>\n                <th>Student</th>\n                <th>Recipient</th>\n                <th>Message</th>\n              </tr>\n            </thead>\n            <tbody>\n              @for (log of notifications; track log.id) {\n              <tr>\n                <td>{{ log.createdAtUtc | date:'MMM d, HH:mm' }}</td>\n                <td>{{ log.eventType }}</td>\n                <td>{{ log.studentName || log.studentId }}</td>\n                <td>{{ log.recipientType }}: {{ log.recipient }}</td>\n                <td>{{ log.message }}</td>\n              </tr>\n              }\n            </tbody>\n          </table></ui-data-table\n        >\n        }\n      </div>\n    </div>\n    }\n\n    <!-- ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ Policy & Holidays ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ -->\n    @if (activeTab() === 'policy') {\n    <div class=\"tab-panel\">\n      <div class=\"hint-bar\">\n        <span\n          >Configure school-wide attendance rules that apply to all classes. Changes take effect immediately for future attendance\n          calculations.</span\n        >\n      </div>\n\n      @if (!policyLoaded()) {\n      <p class=\"muted\">Loading policyÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚Â¦</p>\n      } @else {\n      <div class=\"two-col\">\n        <div class=\"section-block\">\n          <h4>Attendance Rules</h4>\n          <div class=\"field-row\">\n            <label for=\"attendance-workspace-page.template-policy-minimumattendancepercent\">\n              Minimum attendance %\n              <ui-number-input\n                id=\"attendance-workspace-page.template-policy-minimumattendancepercent\"\n                type=\"number\"\n                min=\"0\"\n                max=\"100\"\n                [(ngModel)]=\"policy.minimumAttendancePercent\"\n              />\n              <span class=\"field-hint\">Students below this threshold are flagged in reports (e.g. 75).</span>\n            </label>\n            <label for=\"attendance-workspace-page.template-policy-latetoabsentthreshold\">\n              Late ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ Absent threshold\n              <ui-number-input\n                id=\"attendance-workspace-page.template-policy-latetoabsentthreshold\"\n                type=\"number\"\n                min=\"0\"\n                [(ngModel)]=\"policy.lateToAbsentThreshold\"\n              />\n              <span class=\"field-hint\">Number of late marks before they convert to an absence (0 = disabled).</span>\n            </label>\n            <label for=\"attendance-workspace-page.template-policy-lockafterdays\">\n              Lock attendance after (days)\n              <ui-number-input\n                id=\"attendance-workspace-page.template-policy-lockafterdays\"\n                type=\"number\"\n                min=\"0\"\n                [(ngModel)]=\"policy.lockAfterDays\"\n              />\n              <span class=\"field-hint\">Number of days after a date when marking is locked (0 = never lock).</span>\n            </label>\n            <label>\n              Count late as half-day?\n              <ui-switch [(ngModel)]=\"policy.lateCountAsHalfDay\" />\n            </label>\n          </div>\n          <div class=\"row-actions\">\n            <ui-button variant=\"primary\" type=\"button\" (click)=\"savePolicy()\" [disabled]=\"!canRulesUpdate()\" class=\"primary\">\n              Save Policy\n            </ui-button>\n          </div>\n        </div>\n\n        <div class=\"section-block\">\n          <h4>School Holidays</h4>\n          <p class=\"muted\">Holiday dates are excluded from attendance sessions when calculating percentages.</p>\n          <div class=\"holiday-form\">\n            <label for=\"attendance-workspace-page.template-holidaydate\"\n              >Date <ui-date-picker id=\"attendance-workspace-page.template-holidaydate\" type=\"date\" [(ngModel)]=\"holidayDate\"\n            /></label>\n            <label for=\"attendance-workspace-page.template-holidayname\"\n              >Name <ui-input id=\"attendance-workspace-page.template-holidayname\" [(ngModel)]=\"holidayName\" placeholder=\"e.g. Eid Holiday\"\n            /></label>\n            <ui-button\n              variant=\"primary\"\n              type=\"button\"\n              (click)=\"addHoliday()\"\n              [disabled]=\"!canRulesUpdate() || !holidayDate || !holidayName.trim()\"\n              class=\"primary\"\n            >\n              Add\n            </ui-button>\n          </div>\n          @if (!policy.holidays.length) {\n          <p class=\"empty-hint\">No holidays configured.</p>\n          } @else {\n          <ul class=\"holiday-list\">\n            @for (h of policy.holidays; track h.id) {\n            <li>\n              <span class=\"holiday-date\">{{ formatDisplayDate(h.dateUtc) }}</span>\n              <span class=\"holiday-name\">{{ h.name }}</span>\n              <ui-button\n                variant=\"danger\"\n                type=\"button\"\n                class=\"icon-btn\"\n                (click)=\"deleteHoliday(h.id)\"\n                [disabled]=\"!canRulesUpdate()\"\n                title=\"Remove holiday\"\n              >\n                ÃƒÆ’Ã‚Â¢Ãƒâ€¦Ã¢â‚¬Å“ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢\n              </ui-button>\n            </li>\n            }\n          </ul>\n          }\n        </div>\n      </div>\n      }\n    </div>\n    }\n\n    <!-- ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ Notifications ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚ÂÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ -->\n    @if (activeTab() === 'notifications') {\n    <div class=\"tab-panel\">\n      <div class=\"hint-bar\">\n        <span\n          >Attendance absence notifications sent to guardians. Logs show the channel (SMS / email), recipient, and delivery status.</span\n        >\n      </div>\n\n      <div class=\"row-actions\"></div>\n\n      @if (!notifications.length) {\n      <p class=\"empty-hint\">No notification logs found.</p>\n      } @else {\n      <ui-data-table [pagination]=\"false\"\n        ><table>\n          <thead>\n            <tr>\n              <th>Sent At</th>\n              <th>Student</th>\n              <th>Channel</th>\n              <th>Recipient</th>\n              <th>Message</th>\n              <th>Status</th>\n            </tr>\n          </thead>\n          <tbody>\n            @for (log of notifications; track log.id) {\n            <tr>\n              <td>{{ log.createdAtUtc | date:'MMM d, HH:mm' }}</td>\n              <td>{{ log.studentId }}</td>\n              <td><span class=\"channel-chip\">{{ log.channel }}</span></td>\n              <td>{{ log.recipient }}</td>\n              <td class=\"msg-cell\">{{ log.message }}</td>\n              <td><span [class]=\"'status-chip ' + log.status\">{{ log.status }}</span></td>\n            </tr>\n            }\n          </tbody>\n        </table></ui-data-table\n      >\n      }\n    </div>\n    }\n  </ui-section-card>\n</ui-page>\n"}
